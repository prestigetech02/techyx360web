NEXT_PUBLIC_SITE_URL=https://techyx360.com

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ZeptoMail (Agents → SMTP/API → Send Mail Token)
ZEPTOMAIL_TOKEN=your-zeptomail-send-mail-token
ZEPTOMAIL_FROM_EMAIL=info@techyx360.com
# Optional. Defaults to https://api.zeptomail.com/v1.1/email
# ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
# ZEPTOMAIL_FROM_NAME=Techyx360

# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate-a-long-random-string

# Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-v3-secret-key
# Optional minimum score between 0.0 and 1.0. Defaults to 0.5.
RECAPTCHA_MIN_SCORE=0.5
